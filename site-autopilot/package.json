{
  "name": "site-autopilot",
  "version": "0.1.0",
  "private": true,
  "description": "Tự động hóa: domain -> Cloudflare (DNS, SSL, WAF) -> aaPanel -> website tĩnh có nội dung -> Entity SEO. Dashboard quản lý 10-20 site.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "mock": "cross-env MOCK_MODE=1 tsx --env-file-if-exists=.env src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@hono/node-server": "^1.19.0",
    "google-auth-library": "^10.0.0",
    "hono": "^4.9.0",
    "marked": "^16.0.0",
    "sharp": "^0.34.0",
    "ssh2": "^1.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.0",
    "cross-env": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
