# ===== Dashboard =====
PORT=3000
HOST=127.0.0.1
# URL công khai của dashboard (dùng cho cookie secure), ví dụ https://panel.tenmien.com
BASE_URL=
DATA_DIR=./data
# Chuỗi ngẫu nhiên bất kỳ
SESSION_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD=

# 1 = chạy toàn bộ bằng dịch vụ giả lập, không gọi ra ngoài (để thử dashboard)
MOCK_MODE=0
WORKER_CONCURRENCY=3
HEALTH_CHECK_INTERVAL_MIN=15
NS_POLL_INTERVAL_MIN=5

# ===== Khóa dịch vụ =====
# Các khóa dưới đây (Cloudflare, Claude, Pexels, Google, Telegram) có thể để trống và nhập trên dashboard:
# Cài đặt → Khóa API và dịch vụ. Khóa nhập trên dashboard được mã hóa bằng SESSION_SECRET và ưu tiên hơn file này.
# Không đổi SESSION_SECRET sau khi đã nhập khóa trên dashboard, nếu đổi phải nhập lại.

# ===== Cloudflare =====
# Token: My Profile > API Tokens > Create Token > Custom token, quyền:
#   Zone - Zone - Edit, Zone - DNS - Edit, Zone - Zone Settings - Edit,
#   Zone - Zone WAF - Edit, Zone - Bot Management - Edit, Account - Account Settings - Read
# Zone Resources: Include - All zones from an account - <tài khoản của bạn>
CLOUDFLARE_API_TOKEN=
# Account ID: dashboard Cloudflare > Overview của bất kỳ domain > cột phải "Account ID"
CLOUDFLARE_ACCOUNT_ID=

# ===== aaPanel =====
# URL panel gồm cả cổng, ví dụ https://1.2.3.4:31750 (panel dùng chứng chỉ tự ký, hệ thống bỏ kiểm tra TLS)
AAPANEL_URL=
# Settings > API Interface > bật, sao chép Interface key, thêm IP máy chạy dashboard vào IP whitelist
AAPANEL_API_KEY=
AAPANEL_SERVER_IP=
# 00 = website tĩnh
AAPANEL_PHP_VERSION=00
WEB_ROOT=/www/wwwroot

# ===== SSH tới server aaPanel (để tải file website) =====
SSH_HOST=
SSH_PORT=22
SSH_USER=root
# Đường dẫn khóa private (khuyên dùng) hoặc mật khẩu
SSH_KEY_PATH=./secrets/id_ed25519
SSH_PASSWORD=

# ===== Claude (sinh nội dung) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Model cho lượt biên tập, trống = dùng ANTHROPIC_MODEL
ANTHROPIC_EDITOR_MODEL=

# ===== Pexels (ảnh) =====
PEXELS_API_KEY=

# ===== Google Search Console (tùy chọn) =====
# File JSON service account đã bật "Site Verification API" và "Google Search Console API"
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-service-account.json
# Email Google của bạn để được thêm làm chủ sở hữu property
GOOGLE_OWNER_EMAIL=

# ===== Telegram cảnh báo (tùy chọn) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
